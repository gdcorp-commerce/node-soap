    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },

    // ── GoDaddy Artifactory ───────────────────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/gd-artifactory:latest": {
