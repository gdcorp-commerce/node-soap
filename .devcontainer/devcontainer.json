      "agentContextPath": "/workspace/.devcontainer/agent/agents-devcontainer.md",
      "allowGitPush": true
      // "blockedHosts": "..."  — no fixed production hostnames detected; this library
      // calls whatever SOAP endpoint a consumer's WSDL points at, so nothing to block by default.
    },

    // ── AI agents ─────────────────────────────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/claude-code:latest": {},

